#!/bin/sh /etc/rc.common
# Keep the boot path observable and non-blocking.  Cellular discovery happens
# after the RAM-only boot; this service only records init ordering.

START=06
USE_PROCD=1

start_service() {
	[ -d /run ] || mkdir -p /run
	printf '%s\n' "SP970 early boot: $(date -u +%FT%TZ)" >/run/sp970-early.ready

	# The RAM validation image uses rootfs directly. ujail's pivot_root is not
	# usable there. Temporarily hide capability profiles so individual init
	# scripts skip jail setup; persistent block-root images keep them intact.
	if awk '$2 == "/" && $3 == "rootfs" { found=1 } END { exit !found }' /proc/mounts; then
		mkdir -p /run/sp970-capabilities
		for cap in /etc/capabilities/*.json; do
			[ -e "$cap" ] || continue
			mv "$cap" /run/sp970-capabilities/
		done
	fi

	# WCNSS is ready near 1.3 s. Load the backported WLAN stack before S19/S20
	# so netifd sees phy0 on its first pass instead of waiting for a retry.
	modprobe wcn36xx 2>/dev/null || true

	# The stock order starts dnsmasq before netifd and costs a full ubus
	# timeout in initramfs. S08/S09 wrappers start wpad/netifd first.
	rm -f /etc/rc.d/S19wpad /etc/rc.d/S20network

	# Kernel LED probe leaves green on. Reaching procd changes the visible
	# diagnostic code to blue-only, before Wi-Fi or modem startup.
	for led in /sys/class/leds/*; do
		[ -d "$led" ] || continue
		name=$(basename "$led")
		case "$name" in
			*red*|*power*) echo 0 >"$led/brightness" ;;
			*green*|*wlan*) echo 0 >"$led/brightness" ;;
			*blue*|*wan*) echo 1 >"$led/brightness" ;;
		esac
	done
}
