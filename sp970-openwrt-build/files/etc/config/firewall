config defaults
	option syn_flood '1'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	# MSM8916 has no supported hardware offload path here.  Software flow
	# offload accelerates established LAN/USB-to-cellular forwarded flows.
	option flow_offloading '1'

config zone
	option name 'lan'
	list network 'lan'
	list network 'usbmgmt'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config zone
	option name 'wan'
	list network 'cellular'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

config forwarding
	option src 'lan'
	option dest 'wan'

config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-LAN-Ping'
	option src 'lan'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option target 'ACCEPT'
