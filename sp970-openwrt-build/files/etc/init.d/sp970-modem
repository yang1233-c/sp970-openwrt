#!/bin/sh /etc/rc.common

START=14
STOP=89
USE_PROCD=1

prepare_partlabels() {
	mkdir -p /tmp/rmtfs-partlabels
	ln -sf /dev/mmcblk0p7 /tmp/rmtfs-partlabels/modemst1
	ln -sf /dev/mmcblk0p8 /tmp/rmtfs-partlabels/modemst2
	ln -sf /dev/mmcblk0p9 /tmp/rmtfs-partlabels/fsc
	ln -sf /dev/mmcblk0p10 /tmp/rmtfs-partlabels/fsg
}

start_service() {
	prepare_partlabels

	procd_open_instance tqftp
	procd_set_param command /usr/bin/tqftpserv -d
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance rmtfs
	procd_set_param command /usr/sbin/sp970-rmtfs-start
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# QMI ownership belongs to the q410qmi netifd protocol.  A second periodic
	# qmicli opener can disconnect the single WWAN QMI endpoint on this MPSS.
}

stop_service() {
	# procd stops the tqftp/rmtfs instances.  sp970-modem-led is a watchdog
	# daemon, not a one-shot LED command; invoking it here blocks shutdown.
	return 0
}
