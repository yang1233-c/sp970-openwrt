# A / SP970_MB_V02 minimal seed (OpenWrt 25.12, Linux 6.12)
# Run `make defconfig` in the pinned source tree after applying this file.
CONFIG_TARGET_msm89xx=y
CONFIG_TARGET_msm89xx_msm8916=y
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# Keep the persistent kernel independent of the rootfs payload.  The msm89xx
# target advertises ramdisk support, so defconfig otherwise enables initramfs.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=800

# Early boot / access
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_rpcd=y

# 2.4 GHz AP, DHCP and NAT
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_odhcp6c=y

# USB OTG/RNDIS/NCM and common modem transports
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-gadget=y
CONFIG_PACKAGE_kmod-usb-gadget-eth=y
CONFIG_PACKAGE_kmod-usb-gadget-cdc-composite=y

# Single-owner QMI/QRTR cellular path (cellular is brought up after the AP)
CONFIG_PACKAGE_q410qmi=y
CONFIG_PACKAGE_qcom-modem-daemons=y
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_libqrtr-glib=y
CONFIG_PACKAGE_qrtr-ns=y
CONFIG_PACKAGE_qrtr=y

# Qualcomm storage, remoteproc and WCNSS/WWAN kernel paths
CONFIG_PACKAGE_kmod-mmc=y
# MSM8916 remoteproc, RPMSG/SMD, WCNSS and BAM-DMUX are target built-ins in
# target/linux/msm89xx/config-6.12. They are not package symbols in v25.12.5.
CONFIG_PACKAGE_sp970-firmware=y

# Keep image deterministic and small
CONFIG_DEVEL=y
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_IPV6=y

# Explicitly excluded from this profile:
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-lib-docker is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_samba4-server is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_aria2 is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set


CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-wcn36xx=y
