# First validation gate: RAM-only initramfs, no persistent partition writes.
# Merge this fragment after seed.config and run `make defconfig`.
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TARGET_INITRAMFS_FORCE=y
# Keep the RAM gate below the 16 MiB boot partition: no LuCI or MPSS payload.
# CONFIG_PACKAGE_luci is not set
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-wcn36xx=y
# CONFIG_PACKAGE_modemmanager is not set
# CONFIG_PACKAGE_luci-proto-modemmanager is not set
# CONFIG_PACKAGE_libqmi is not set
# CONFIG_PACKAGE_qrtr-ns is not set
# CONFIG_PACKAGE_sp970-firmware is not set
# CONFIG_PACKAGE_sp970-modem-firmware is not set
CONFIG_PACKAGE_sp970-wcnss-firmware=y
# Do not add a root=PARTUUID here: initramfs must prove kernel/DTB first.

